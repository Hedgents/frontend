# Never put funded wallet keys or seed phrases in this file. All onchain actions are wallet-signed.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
HEDGENTS_SOLANA_MAINNET_RPC_URLS=https://api.mainnet-beta.solana.com
HEDGENTS_SCARCITY_DEVNET_RPC_URLS=https://api.devnet.solana.com
HEDGENTS_SCARCITY_MAINNET_RPC_URLS=

# Production fails closed unless this is exactly true. Keep false until RPC and wallet checks pass.
HEDGENTS_EXECUTION_ENABLED=false
# Production also fails closed unless every entry is a registered product ID. Start the paid canary with PAXG only.
HEDGENTS_EXECUTION_PRODUCT_ALLOWLIST=gold-paxg
# Closed-beta orders are server-capped at every quote, order, and submission boundary.
HEDGENTS_BETA_MAX_USD=100
# Maximum net SOL the taker's wallet may lose in either exact simulation, including fees and rent.
# 10,000,000 lamports = 0.01 SOL. Execution is disabled when this is absent or malformed.
HEDGENTS_MAX_SOL_DEBIT_LAMPORTS=10000000
# Comma-separated lowercase SHA-256 fingerprints from reviewed, passing zero-spend matrix routes.
# Production execution fails closed while this is empty or when a route uses a new program set.
HEDGENTS_SOLANA_PROGRAM_FINGERPRINT_ALLOWLIST=
# Isolated wallet-QA only. It permits quote signing but hard-disables /execute submission.
HEDGENTS_WALLET_REJECTION_MODE=false
# Terminal-only opt-in for starting new external Rail SDK funding transfers.
# Keep false for the Solana-USDC beta. Pending CCTP source burns remain recoverable when false.
HEDGENTS_RAIL_FUNDING_ENABLED=false

# Server-only Hermes credential. Pyth documents authentication as required from 2026-08-18.
PYTH_API_KEY=

# Server-only operator configuration. Addresses are placeholders.
HEDGENTS_SCARCITY_OPERATOR_JSON={"schemaVersion":"1.0.0","cluster":"devnet","programAddress":"CJHWP9ed1BzWVQhUeJPQ9jJb4YcVWiFNpQcG7mPEGk86","admin":"REPLACE_WITH_UPGRADE_AUTHORITY_ADMIN","collateralMint":"REPLACE_WITH_DEVNET_USDC_MINT","feeRecipient":"REPLACE_WITH_FEE_TOKEN_ACCOUNT","resolver":"REPLACE_WITH_RESOLVER_WALLET","tradingFeeBps":25}

# Add only after the program and reviewed market accounts actually exist.
HEDGENTS_SCARCITY_DEPLOYMENT_JSON={"schemaVersion":"1.0.0","cluster":"devnet","programAddress":"CJHWP9ed1BzWVQhUeJPQ9jJb4YcVWiFNpQcG7mPEGk86","admin":"REPLACE_WITH_UPGRADE_AUTHORITY_ADMIN","collateralMint":"REPLACE_WITH_DEVNET_USDC_MINT","feeRecipient":"REPLACE_WITH_FEE_TOKEN_ACCOUNT","resolver":"REPLACE_WITH_CURRENT_CONFIG_RESOLVER","tradingFeeBps":25,"markets":{"copper-tightness-70-2026":{"creationSignature":"REPLACE_WITH_CONFIRMED_CREATION_SIGNATURE","resolver":"REPLACE_WITH_MARKET_SNAPSHOTTED_RESOLVER"}},"curveMarkets":{"copper-tightness-70-2026":{"creationSignature":"REPLACE_WITH_CONFIRMED_CURVE_CREATION_SIGNATURE","resolver":"REPLACE_WITH_CURVE_SNAPSHOTTED_RESOLVER"}}}

# Mainnet operator and deployment manifests additionally require the same governance object.
# Keep mainnet disabled until every URL exists and the addresses are controlled by the reviewed multisig.
# "governance":{"authorityModel":"multisig","minimumApprovals":2,"manualChallengeWindowHours":48,"auditReportUrl":"https://...","disputePolicyUrl":"https://...","incidentResponseUrl":"https://..."}

# Configure a private Vercel Blob store before production evidence or observation publication.
BLOB_READ_WRITE_TOKEN=

# Access cookies are HMAC-signed. Store only SHA-256 of the administrator code.
HEDGENTS_AUTH_SECRET=
HEDGENTS_ADMIN_CODE_HASH=
# Optional local-development bootstrap only. Production ignores this beta hash;
# create individually revocable grants from the authenticated admin panel.
HEDGENTS_INVITE_CODE_HASH=

# Vercel sends this bearer secret to the daily detector cron. Generate a long random value.
CRON_SECRET=

# Optional. Crossref recommends identifying polite-pool traffic with an operator email.
HEDGENTS_CROSSREF_MAILTO=
